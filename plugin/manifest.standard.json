{
  "manifestVersion": 5,
  "id": "com.fangrui.sam-selection",
  "name": "FR SAM 文本选区",
  "version": "0.9.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "26.0.0",
    "data": {"apiVersion": 2, "loadEvent": "startup"}
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "sam31SelectionPanel",
      "label": {"default": "FR SAM 文本选区"},
      "minimumSize": {"width": 280, "height": 320},
      "preferredDockedSize": {"width": 320, "height": 430},
      "preferredFloatingSize": {"width": 360, "height": 460}
    },
    {
      "type": "command",
      "id": "runRecordedDefaults",
      "label": {"default": "执行 FR SAM 默认选区"}
    }
  ]
}
