{
  "$comment": "开发期 Hybrid 清单。公开分发前把 id 替换为 Adobe Developer Distribution 分配的正式 ID。",
  "manifestVersion": 6,
  "id": "com.fr.sam31-selection.dev",
  "name": "SAM 3.1 文本选区",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "25.0.0",
    "data": {"apiVersion": 2, "loadEvent": "startup"}
  },
  "addon": {
    "name": "sam31-supervisor.uxpaddon"
  },
  "requiredPermissions": {
    "enableAddon": true
  },
  "entryPoints": [
    {
      "type": "panel",
      "id": "sam31SelectionPanel",
      "label": {"default": "SAM 3.1 文本选区"},
      "minimumSize": {"width": 280, "height": 320},
      "preferredDockedSize": {"width": 320, "height": 430},
      "preferredFloatingSize": {"width": 360, "height": 460}
    },
    {
      "type": "command",
      "id": "runRecordedDefaults",
      "label": {"default": "执行 SAM 3.1 默认选区"}
    }
  ]
}
